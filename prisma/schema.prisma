  @@index([productTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_booking_producttitle")
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_booking_contactname")
  @@index([contactEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_booking_contactemail")
  @@index([contactPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_booking_contactphone")
}

