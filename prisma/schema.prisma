// prisma/schema.prisma
// Wild Peak Souls — Prisma schema
// PostgreSQL. See docs/ARCHITECTURE.md for the domain map.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // On serverless this is the provider's pooled (PgBouncer) connection string.
  // Migrations need a session connection instead, so they are run with
  // DATABASE_URL overridden for that one command — see docs/DEPLOYMENT.md.
  // `directUrl` is deliberately not declared here: Prisma hard-fails when a
  // declared env var is missing, which would break every non-serverless
  // deployment that has no reason to set it.
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CONTENT_MANAGER
  SUPPORT_AGENT
  FINANCE_MANAGER
  CUSTOMER
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  PASSWORD_RESET
  PHONE_VERIFY
  EMAIL_VERIFY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

enum TourType {
  FIXED_DATE
  FLEXIBLE_DATE
  CUSTOMIZABLE
}

enum AccommodationType {
  HOTEL
  RESORT
  HOMESTAY
  TREEHOUSE
  COTTAGE
  VILLA
  HOSTEL
  GUEST_HOUSE
  CAMP
}

enum ProductType {
  EVENT
  TOUR
  ACTIVITY
  ACCOMMODATION
  CUSTOM
  SERVICE
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  SSLCOMMERZ
  BANK_TRANSFER
  CASH
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  IN_PROGRESS
  CONFIRMED
  RESOLVED
  COMPLETED
  CANCELLED
  CLOSED
}

enum VisaRequestStatus {
  NEW
  CONTACTED
  DOCUMENTS_REQUESTED
  DOCUMENTS_RECEIVED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  BOOKING
  PAYMENT
  VISA
  SUPPORT
  MESSAGE
  SYSTEM
  MARKETING
  SECURITY
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The phase a contest is in. Dates decide what the public sees; this decides
/// whether the contest exists publicly at all.
enum ContestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContestEntryStatus {
  PENDING
  APPROVED
  REJECTED
  SHORTLISTED
  WINNER
}

enum NoticeType {
  INFO
  WARNING
  SUCCESS
  IMPORTANT
  MAINTENANCE
}

enum AdFrequencyWindow {
  SESSION
  DAY
  WEEK
  EVER
}

enum AdPlacement {
  HOME_BILLBOARD
  HOME_MODAL
  SIDEBAR
  FOOTER
  LISTING_BANNER
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum MessageType {
  CUSTOMER
  STAFF
  INTERNAL_NOTE
  SYSTEM
}

enum WishlistItemType {
  DESTINATION
  EVENT
  TOUR
  ACTIVITY
  ACCOMMODATION
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?    @unique
  passwordHash    String?
  image           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                UserRole[]
  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  otpChallenges        OtpChallenge[]
  passwordResetTokens  PasswordResetToken[]
  bookings             Booking[]
  reviews              Review[]
  notifications        Notification[]
  wishlistItems        WishlistItem[]
  supportTokens        SupportToken[]        @relation("SupportCustomer")
  assignedTokens       SupportToken[]        @relation("SupportAssignee")
  supportMessages      SupportMessage[]
  conversations        Conversation[]        @relation("ConversationCustomer")
  conversationSeats    ConversationParticipant[]
  messages             Message[]
  visaRequests         VisaRequest[]
  assignedVisaRequests VisaRequest[]         @relation("VisaAssignee")
  contactRequests      ContactRequest[]
  assignedContacts     ContactRequest[]      @relation("ContactAssignee")
  customTourRequests   CustomTourRequest[]
  assignedCustomTours  CustomTourRequest[]   @relation("CustomTourAssignee")
  flightInquiries      FlightInquiry[]
  assignedFlights      FlightInquiry[]       @relation("FlightAssignee")
  auditLogs            AuditLog[]
  mediaUploads         MediaAsset[]
  verifiedPayments     Payment[]             @relation("PaymentVerifier")
  createdTransactions  FinancialTransaction[]
  createdExpenses      Expense[]             @relation("ExpenseCreator")
  ownedExpenses        Expense[]             @relation("ExpenseEmployee")
  salaryRecords        SalaryRecord[]
  settingUpdates       Setting[]
  posts                Post[]                @relation("PostAuthor")
  postComments         PostComment[]         @relation("CommentAuthor")
  moderatedComments    PostComment[]         @relation("CommentModerator")
  contestEntries       ContestEntry[]        @relation("ContestEntrant")
  moderatedEntries     ContestEntry[]        @relation("ContestEntryModerator")
  contestVotes         ContestVote[]

  @@index([status])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_user_name")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_user_email")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_user_phone")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  label       String
  description String?
  systemRole  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
  pageAccess  RolePageAccess[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String?
  identifier  String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitCounter {
  id        String   @id @default(cuid())
  bucket    String
  windowEnd DateTime
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bucket, windowEnd])
  @@index([windowEnd])
}

// ---------------------------------------------------------------------------
// Media & settings
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String   @id @default(cuid())
  provider  String   @default("cloudinary")
  publicId  String?
  url       String
  secureUrl String?
  type      String   @default("image")
  mimeType  String?
  width     Int?
  height    Int?
  size      Int?
  /// Video length in whole seconds. Read back from Cloudinary rather than the
  /// browser, because the entry rules cap videos at 20 seconds.
  durationSeconds Int?
  altText   String?
  folder    String?
  createdById String?
  createdAt DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  destinationCovers Destination[]  @relation("DestinationCover")
  destinationGallery DestinationGallery[]
  eventCovers       Event[]        @relation("EventCover")
  eventGallery      EventGallery[]
  tourCovers        Tour[]         @relation("TourCover")
  activityCovers    Activity[]     @relation("ActivityCover")
  accommodationCovers Accommodation[] @relation("AccommodationCover")
  roomTypeCovers    RoomType[]     @relation("RoomTypeCover")
  visaCountryFlags  VisaCountry[]  @relation("VisaCountryFlag")
  advertisements    Advertisement[]
  expenseReceipts   Expense[]
  postCovers        Post[]         @relation("PostCover")
  heroSlides        HeroSlide[]    @relation("HeroMedia")
  contestCovers     Contest[]      @relation("ContestCover")
  contestPrizes     ContestPrize[]
  contestJudges     ContestJudge[]
  contestSponsors   ContestSponsor[]
  contestGallery    ContestGalleryItem[]
  contestEntries    ContestEntry[]

  @@index([folder])
  @@index([createdAt])
}

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  category    String      @default("general")
  isSecret    Boolean     @default(false)
  label       String?
  description String?
  updatedById String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
}

// ---------------------------------------------------------------------------
// Travel catalogue
// ---------------------------------------------------------------------------

model Destination {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  country          String        @default("Bangladesh")
  region           String?
  shortDescription String?
  description      String?
  bestTimeToVisit  String?
  travelTips       String?
  latitude         Float?
  longitude        Float?
  coverMediaId     String?
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  coverMedia     MediaAsset?          @relation("DestinationCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  gallery        DestinationGallery[]
  events         Event[]
  tours          Tour[]
  activities     Activity[]
  accommodations Accommodation[]

  @@index([status])
  @@index([featured])
  @@index([country])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_destination_name")
  @@index([region(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_destination_region")
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_destination_shortdescription")
}

model DestinationGallery {
  id            String @id @default(cuid())
  destinationId String
  mediaId       String
  sortOrder     Int    @default(0)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  media       MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([destinationId, mediaId])
  @@index([destinationId])
}

model Event {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  shortDescription String?
  description      String?
  destinationId    String?
  eventType        String?
  coverMediaId     String?
  startAt          DateTime
  endAt            DateTime
  duration         String?
  capacity         Int         @default(0)
  reservedSeats    Int         @default(0)
  price            Decimal     @db.Decimal(12, 2)
  discountPrice    Decimal?    @db.Decimal(12, 2)
  bookingDeadline  DateTime?
  difficulty       Difficulty  @default(MODERATE)
  meetingPoint     String?
  transport        String?
  accommodation    String?
  meals            String?
  travelTips       String?
  additionalInfo   String?
  featured         Boolean     @default(false)
  status           EventStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  destination    Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  coverMedia     MediaAsset?          @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  gallery        EventGallery[]
  itinerary      EventItinerary[]
  options        EventOption[]
  policies       EventPolicy[]
  eventActivities EventActivity[]

  @@index([status])
  @@index([startAt])
  @@index([destinationId])
  @@index([featured])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_event_title")
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_event_shortdescription")
}

model EventGallery {
  id        String @id @default(cuid())
  eventId   String
  mediaId   String
  sortOrder Int    @default(0)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaId])
  @@index([eventId])
}

model EventActivity {
  eventId    String
  activityId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([eventId, activityId])
  @@index([activityId])
}

model EventItinerary {
  id          String @id @default(cuid())
  eventId     String
  dayNumber   Int
  title       String
  description String?
  sortOrder   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventOption {
  id          String        @id @default(cuid())
  eventId     String
  title       String
  description String?
  price       Decimal       @db.Decimal(12, 2) @default(0)
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventPolicy {
  id        String @id @default(cuid())
  eventId   String
  title     String
  content   String
  sortOrder Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Tour {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String?
  description      String?
  destinationId    String?
  tourType         TourType      @default(FLEXIBLE_DATE)
  coverMediaId     String?
  duration         String?
  durationDays     Int           @default(1)
  basePrice        Decimal       @db.Decimal(12, 2)
  discountPrice    Decimal?      @db.Decimal(12, 2)
  highlights       String?
  inclusions       String?
  exclusions       String?
  accommodation    String?
  transport        String?
  policies         String?
  maxGroupSize     Int           @default(20)
  difficulty       Difficulty    @default(EASY)
  featured         Boolean       @default(false)
  status           ContentStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  destination Destination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  coverMedia  MediaAsset?     @relation("TourCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  itinerary   TourItinerary[]

  @@index([status])
  @@index([destinationId])
  @@index([featured])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_tour_title")
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_tour_shortdescription")
}

model TourItinerary {
  id          String @id @default(cuid())
  tourId      String
  dayNumber   Int
  title       String
  description String?
  sortOrder   Int    @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Activity {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  destinationId String?
  coverMediaId  String?
  shortDescription String?
  description   String?
  duration      String?
  price         Decimal       @db.Decimal(12, 2) @default(0)
  difficulty    Difficulty    @default(EASY)
  minAge        Int?
  maxAge        Int?
  included      String?
  excluded      String?
  safetyInfo    String?
  bookable      Boolean       @default(false)
  trending      Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  destination    Destination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  coverMedia     MediaAsset?     @relation("ActivityCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  eventActivities EventActivity[]

  @@index([status])
  @@index([trending])
  @@index([destinationId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_activity_name")
}

model Accommodation {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  type          AccommodationType @default(HOTEL)
  destinationId String?
  coverMediaId  String?
  address       String?
  shortDescription String?
  description   String?
  amenities     String?
  rules         String?
  policies      String?
  checkInTime   String            @default("14:00")
  checkOutTime  String            @default("12:00")
  featured      Boolean           @default(false)
  status        ContentStatus     @default(DRAFT)
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  coverMedia  MediaAsset?  @relation("AccommodationCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  roomTypes   RoomType[]

  @@index([status])
  @@index([destinationId])
  @@index([type])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_accommodation_name")
}

model RoomType {
  id              String        @id @default(cuid())
  accommodationId String
  name            String
  description     String?
  capacity        Int           @default(2)
  price           Decimal       @db.Decimal(12, 2)
  totalUnits      Int           @default(1)
  amenities       String?
  coverMediaId    String?
  status          ContentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  accommodation Accommodation   @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  coverMedia    MediaAsset?     @relation("RoomTypeCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  inventory     RoomInventory[]

  @@index([accommodationId])
  @@index([status])
}

model RoomInventory {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  totalUnits Int
  bookedUnits Int     @default(0)
  priceOverride Decimal? @db.Decimal(12, 2)
  blocked    Boolean  @default(false)

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Visa
// ---------------------------------------------------------------------------

model VisaCountry {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  code        String?
  description String?
  flagMediaId String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  flagMedia MediaAsset? @relation("VisaCountryFlag", fields: [flagMediaId], references: [id], onDelete: SetNull)
  visaTypes VisaType[]

  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_visacountry_name")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_visacountry_slug")
}

model VisaType {
  id                       String        @id @default(cuid())
  countryId                String
  name                     String
  slug                     String
  title                    String?
  summary                  String?
  importantNotes           String?
  generalDocuments         String?
  businessOwnerDocuments   String?
  studentDocuments         String?
  otherApplicantDocuments  String?
  softCopyInstructions     String?
  hardCopyInstructions     String?
  processingInfo           String?
  additionalInfo           String?
  serviceFee               Decimal?      @db.Decimal(12, 2)
  status                   ContentStatus @default(PUBLISHED)
  seoTitle                 String?
  seoDescription           String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  country  VisaCountry   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  requests VisaRequest[]

  @@unique([countryId, slug])
  @@index([status])
}

model VisaRequest {
  id          String            @id @default(cuid())
  userId      String?
  visaTypeId  String?
  name        String
  email       String
  phone       String
  nationality String
  message     String?
  status      VisaRequestStatus @default(NEW)
  assignedToId String?
  staffNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  visaType   VisaType? @relation(fields: [visaTypeId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("VisaAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Flights & trains (informational)
// ---------------------------------------------------------------------------

model Airport {
  id        String   @id @default(cuid())
  iata      String   @unique
  name      String
  city      String
  country   String   @default("Bangladesh")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([city])
}

model FlightRoute {
  id             String   @id @default(cuid())
  airline        String
  flightNumber   String
  originIata     String
  destinationIata String
  departureTime  String
  arrivalTime    String
  durationMinutes Int
