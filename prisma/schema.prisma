// ---------------------------------------------------------------------------
// Contests
// ---------------------------------------------------------------------------

/// A photo/video contest people enter and vote on.
///
/// Which phase the contest is in is derived from the dates, not stored: a
/// stored phase would need a scheduled job to advance it, and would be wrong
/// for exactly as long as that job was late. `status` only decides whether the
/// contest is public at all.
model Contest {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  tagline       String?
  /// What the contest is about, in Markdown.
  description   String
  /// The theme entrants are shooting for, e.g. "Monsoon in the hills".
  theme         String?
  rules         String?
  prizeSummary  String?
  coverMediaId  String?
  status        ContestStatus @default(DRAFT)

  // Timeline. Entries open at startAt, close at entryDeadline; voting runs
  // between votingStartAt and votingEndAt; results appear from resultsAt.
  startAt        DateTime
  entryDeadline  DateTime
  votingStartAt  DateTime?
  votingEndAt    DateTime?
  resultsAt      DateTime?

  // Entry rules.
  allowImages       Boolean @default(true)
  allowVideos       Boolean @default(true)
  /// Hard cap per entrant, counted across approved and pending entries.
  maxEntriesPerUser Int     @default(1)
  maxImageBytes     Int     @default(2097152)
  maxVideoSeconds   Int     @default(20)

  /// How much the public vote counts toward the combined score, as a
  /// percentage. The judges' marks carry the rest.
  publicVoteWeight Int @default(25)
  /// How many entries reach the voting round.
  shortlistSize    Int @default(10)

  /// Pin to the home page while live. The navbar link appears on its own
  /// whenever a contest is published and has not finished.
  featureOnHome Boolean @default(true)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverMedia MediaAsset?          @relation("ContestCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  prizes     ContestPrize[]
  judges     ContestJudge[]
  sponsors   ContestSponsor[]
  gallery    ContestGalleryItem[]
  entries    ContestEntry[]
  votes      ContestVote[]

  @@index([status])
  @@index([status, entryDeadline])
  @@index([startAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_contest_title")
}

model ContestPrize {
  id          String  @id @default(cuid())
  contestId   String
  /// 1 for first place, 2 for second, and so on. 0 for a non-ranked prize.
  position    Int     @default(0)
  title       String
  description String?
  /// Free text so "3 nights in Sajek" is as valid as "50,000 BDT".
  value       String?
  mediaId     String?
  sortOrder   Int     @default(0)

  contest Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([contestId, position])
}

model ContestJudge {
  id         String  @id @default(cuid())
  contestId  String
  name       String
  role       String?
  bio        String?
  profileUrl String?
  mediaId    String?
  sortOrder  Int     @default(0)

  contest Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([contestId, sortOrder])
}

model ContestSponsor {
  id         String  @id @default(cuid())
  contestId  String
  name       String
  tier       String?
  websiteUrl String?
  mediaId    String?
  sortOrder  Int     @default(0)

  contest Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([contestId, sortOrder])
}

/// Pictures the agency adds itself — last year's winners, the location, the
/// prizes in the flesh. Nothing entrants upload appears here.
model ContestGalleryItem {
  id        String  @id @default(cuid())
  contestId String
  mediaId   String
  caption   String?
  sortOrder Int     @default(0)

  contest Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([contestId, sortOrder])
}

/// One submission.
///
/// The entrant must be signed in — `userId` is required — so that a person
/// cannot enter repeatedly behind different names, and so the agency has an
/// account to contact if they win. The contact fields are still stored
/// separately: what someone types on the entry form is what they want used for
/// the contest, which is not always what is on their account.
model ContestEntry {
  id        String @id @default(cuid())
  contestId String
  userId    String

  entrantName  String
  entrantEmail String
  entrantPhone String
  /// Facebook, LinkedIn or any other profile they want credited.
  socialUrl    String?
  location     String
  description  String

  mediaId String

  status ContestEntryStatus @default(PENDING)

  /// Judges' mark out of 100. Combined with the public vote share using the
  /// contest's publicVoteWeight to produce the ranking staff see.
  judgeScore Int?
  /// Final placing, set by staff. 1, 2 or 3 for the winners.
  rank       Int?

  /// Kept in step with the ContestVote rows inside the same transaction, so
  /// the gallery can sort by popularity without counting rows per card.
  voteCount Int @default(0)

  moderationNote String?
  moderatedAt    DateTime?
  moderatedById  String?

  /// Truncated hash of the submitting IP. Enough to spot one person entering
  /// from a script, not enough to recover the address.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contest     Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user        User          @relation("ContestEntrant", fields: [userId], references: [id], onDelete: Cascade)
  media       MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  moderatedBy User?         @relation("ContestEntryModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  votes       ContestVote[]

  @@index([contestId, status])
  @@index([contestId, voteCount])
  @@index([contestId, rank])
  @@index([userId])
  @@index([entrantName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_contestentry_name")
  @@index([entrantEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_contestentry_email")
}

/// One vote. The unique constraint on (contestId, userId) is the whole
/// anti-ballot-stuffing design: one signed-in person, one vote per contest,
/// enforced by the database rather than by a check that could be raced.
model ContestVote {
  id        String   @id @default(cuid())
  contestId String
  entryId   String
  userId    String
  ipHash    String?
  createdAt DateTime @default(now())

  contest Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entry   ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([entryId])
}
