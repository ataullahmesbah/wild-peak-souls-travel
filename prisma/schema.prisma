  @@index([publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([views])
  @@index([status, publishedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_post_title")
  @@index([excerpt(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_trgm_post_excerpt")
}

/// Blog categories. Kept as their own table rather than a free-text column so
